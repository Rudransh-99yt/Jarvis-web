# ==============================================================================
# Jarvis Web - Production Environment Configuration Contract
# All values in this template are safe placeholders. Never commit secrets to git.
# ==============================================================================

# 1. Server Runtime & Networking
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_APP_URL=
ALLOWED_ORIGINS=

# 2. Artificial Intelligence & Search Providers
# Server-side Gemini API key (never exposed to client browser)
GEMINI_API_KEY=
# Optional Search Provider API key
YOU_API_KEY=

# 3. Authentication & Security
# Cryptographic secret for signing session tokens (HMAC-SHA256, >= 32 chars)
JARVIS_AUTH_SECRET=
# Cryptographic secret for short-lived websocket / ticket exchange
TICKET_SECRET=
# Private Alpha Access Gating (true | false)
PRIVATE_ALPHA_ENABLED=false
# Comma-separated list of permitted emails when private alpha is active
PRIVATE_ALPHA_ALLOWLIST=

# 4. Persistence & Object Storage
# Storage provider backend ('local' disk repository)
STORAGE_PROVIDER=local
# Optional custom paths for persistent data stores
JARVIS_DB_FILE=
CLASS_SESSIONS_STORE_FILE=
ACADEMIC_INTEGRATION_STORE_FILE=
SMARTBOARD_STORE_FILE=

# 5. Client Application Settings
VITE_APP_NAME=J.A.R.V.I.S. Web

# 6. Email Authentication & OTP Delivery (Milestone 2.2 / Local Dev Gmail SMTP)
# Options: 'resend' (production default), 'smtp' (local development Gmail SMTP), 'console', 'mock'
JARVIS_EMAIL_PROVIDER=
JARVIS_EMAIL_FROM=
JARVIS_EMAIL_TIMEOUT_MS=
# For Resend (Production):
RESEND_API_KEY=
# For Gmail SMTP (Local Development with JARVIS_EMAIL_PROVIDER=smtp):
SMTP_USER=
SMTP_PASS=
