            {
              "id": "elem-t1",
              "type": "text",
              "text": "Gauss’s Law: \\oint \\vec{E} \\cdot d\\vec{A} = \\frac{q_{\\text{enc}}}{\\varepsilon_0}",
              "fontSize": 24,
